---
import type { CollectionEntry } from 'astro:content';
import CategoryBadge from './CategoryBadge.astro';

export interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, category, date, tags, image, imageAlt } = post.data;

const href = `/blog/${post.id}`;
const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<article class="group">
  <a
    href={href}
    class="flex gap-4 rounded-2xl border border-border bg-page p-3 transition-colors hover:border-faint/60 sm:gap-5 sm:p-4"
  >
    {
      image && (
        <div class="hidden h-28 w-40 shrink-0 overflow-hidden rounded-xl bg-subtle sm:block lg:h-32 lg:w-48">
          <img
            src={image}
            alt={imageAlt || title}
            class="post-img h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
            loading="lazy"
            decoding="async"
            width="192"
            height="128"
          />
        </div>
      )
    }

    <div class="flex min-w-0 flex-1 flex-col">
      <div class="flex items-start justify-between gap-4">
        <CategoryBadge category={category} />
        <time class="shrink-0 text-[13px] text-faint" datetime={date.toISOString()}>{formattedDate}</time>
      </div>

      <h3 class="mt-1.5 text-base font-bold leading-snug tracking-tight text-ink transition-colors group-hover:text-blue sm:text-[18px]">
        {title}
      </h3>

      <p class="mt-1.5 line-clamp-2 text-[14px] leading-relaxed text-muted sm:text-sm">
        {description}
      </p>

      {
        tags.length > 0 && (
          <div class="mt-3 flex flex-wrap gap-1.5">
            {tags.map((tag) => (
              <span class="rounded-md bg-tag-soft px-2 py-0.5 text-[12px] font-medium text-tag">{tag}</span>
            ))}
          </div>
        )
      }
    </div>
  </a>
</article>

<script>
  document.querySelectorAll<HTMLImageElement>('.post-img').forEach((img) => {
    img.addEventListener('error', () => {
      img.style.opacity = '0';
    });
  });
</script>
