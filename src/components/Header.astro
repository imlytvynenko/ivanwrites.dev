---
const navLinks = [
  { label: 'Blog', href: '/blog' },
  { label: 'Software', href: '/software' },
  { label: 'Lifestyle', href: '/lifestyle' },
  { label: 'About', href: '/about' },
  { label: 'Projects', href: '/projects' },
  { label: 'Now', href: '/now' },
  { label: 'Uses', href: '/uses' },
];

const currentPath = Astro.url.pathname;

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath === href || currentPath.startsWith(`${href}/`);
}
---

<header class="sticky top-0 z-50 border-b border-border bg-page/90 backdrop-blur">
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-5 py-5 sm:px-6 sm:py-6">
    <a href="/" class="flex shrink-0 items-center gap-3 transition-opacity hover:opacity-80">
      <span class="flex h-14 w-14 items-center justify-center overflow-hidden rounded-full border border-border bg-white">
        <img src="/icons/lion-icon.png" alt="Ivan Writes logo" class="h-11 w-11 object-contain" width="44" height="44" />
      </span>
      <span class="leading-tight">
        <span class="block text-[18px] font-bold tracking-tight text-ink">Ivan Writes</span>
        <span class="block text-[13px] text-faint">ivanwrites.dev</span>
      </span>
    </a>

    <nav class="hidden items-center gap-6 lg:flex" aria-label="Main">
      {
        navLinks.map(({ label, href }) => (
          <a
            href={href}
            class:list={[
              'text-[16px] transition-colors',
              isActive(href)
                ? 'font-semibold text-ink underline decoration-ink decoration-2 underline-offset-[10px]'
                : 'text-muted hover:text-ink',
            ]}
          >
            {label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-1">
      <button
        type="button"
        class="flex h-9 w-9 items-center justify-center rounded-lg text-muted transition-colors hover:bg-subtle hover:text-ink"
        aria-label="Search"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="7" />
          <path d="m20 20-3.5-3.5" />
        </svg>
      </button>
      <span class="hidden h-5 w-px bg-border sm:block" aria-hidden="true"></span>
      <button
        type="button"
        class="flex h-9 w-9 items-center justify-center rounded-lg text-muted transition-colors hover:bg-subtle hover:text-ink"
        aria-label="Toggle theme"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
        </svg>
      </button>
      <button
        type="button"
        class="flex h-9 w-9 items-center justify-center rounded-lg text-muted transition-colors hover:bg-subtle hover:text-ink lg:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        id="menu-toggle"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="hidden border-t border-border px-5 py-4 lg:hidden" aria-label="Mobile">
    <ul class="flex flex-col gap-3">
      {
        navLinks.map(({ label, href }) => (
          <li>
            <a
              href={href}
              class:list={[
                'block py-1 text-[16px] transition-colors',
                isActive(href) ? 'font-semibold text-ink' : 'text-muted hover:text-ink',
              ]}
            >
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const mobileNav = document.getElementById('mobile-nav');

  toggle?.addEventListener('click', () => {
    const isOpen = mobileNav?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(isOpen));
  });
</script>
