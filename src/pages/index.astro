---
import { getCollection } from 'astro:content';
import Layout from '../components/Layout.astro';
import PostCard from '../components/PostCard.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const latest = posts.slice(0, 4);

const heroTopics = [
  { label: 'Software Development', icon: 'code', color: 'text-blue', bg: 'bg-blue-soft' },
  { label: 'Running', icon: 'run', color: 'text-green', bg: 'bg-green-soft' },
  { label: 'Travel', icon: 'travel', color: 'text-indigo', bg: 'bg-indigo-soft' },
  { label: 'Productivity', icon: 'task', color: 'text-amber', bg: 'bg-amber-soft' },
];
---

<Layout>
  <main class="flex-1">
    <!-- Hero -->
    <section class="mx-auto max-w-5xl px-5 pt-6 pb-12 sm:px-6 sm:pt-8 sm:pb-16">
      <div class="grid items-center gap-10 lg:grid-cols-[1.05fr_1fr] lg:gap-8">
        <div>
          <p class="text-base font-medium text-muted sm:text-lg">Hi, I'm Ivan.</p>
          <div class="mt-3 h-px w-8 bg-faint" aria-hidden="true"></div>

          <h1 class="mt-5 text-[2.25rem] font-bold leading-[1.08] tracking-tight text-ink sm:text-5xl">
            I build software and write about life.
          </h1>

          <p class="mt-5 max-w-md text-[16px] leading-relaxed text-muted">
            This is my space to share thoughts on engineering, lifestyle, running, travel, and the lessons I learn along the way.
          </p>

          <div class="mt-7 flex flex-wrap items-center gap-3">
            <a
              href="/blog"
              class="inline-flex items-center gap-2 rounded-lg bg-ink px-5 py-2.5 text-sm font-medium text-page transition-colors hover:bg-ink-soft"
            >
              Read the blog
              <span aria-hidden="true">→</span>
            </a>
            <a
              href="/about"
              class="inline-flex items-center rounded-lg border border-border bg-page px-5 py-2.5 text-sm font-medium text-ink transition-colors hover:border-faint"
            >
              About me
            </a>
          </div>

          <div class="mt-7 flex flex-wrap gap-2.5">
            {
              heroTopics.map(({ label, icon, color, bg }) => (
                <span class:list={['inline-flex items-center gap-1.5 rounded-full border border-border px-3 py-1.5 text-[13.5px] font-medium', bg, color]}>
                  {icon === 'code' && (
                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="m16 18 6-6-6-6M8 6l-6 6 6 6" />
                    </svg>
                  )}
                  {icon === 'run' && (
                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M4 16l2.5-1.5L9 18l3-6 3 2 4-3M16 6a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z" />
                    </svg>
                  )}
                  {icon === 'travel' && (
                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M17.8 19.2 16 11l3.5-3.5a2.12 2.12 0 0 0-3-3L13 8 4.8 6.2a1 1 0 0 0-.9 1.7l4.6 3.3-2.3 2.3-2.4-.4-1 1 3 1.8 1.8 3 1-1-.4-2.4 2.3-2.3 3.3 4.6a1 1 0 0 0 1.7-.9Z" />
                    </svg>
                  )}
                  {icon === 'task' && (
                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2" />
                      <rect width="6" height="4" x="9" y="3" rx="1" />
                      <path d="m9 14 2 2 4-4" />
                    </svg>
                  )}
                  {label}
                </span>
              ))
            }
          </div>
        </div>

        <div class="hidden justify-center lg:flex">
          <img
            src="/illustrations/workspace-line-art.svg"
            alt="Line drawing of a desk with a plant, laptop, and coffee mug"
            class="w-full max-w-md"
            width="460"
            height="320"
          />
        </div>
      </div>
    </section>

    <!-- Latest posts -->
    <section class="mx-auto max-w-5xl px-5 pb-20 sm:px-6 sm:pb-24">
      <div class="flex items-end justify-between gap-4">
        <h2 class="text-xl font-bold tracking-tight text-ink sm:text-2xl">Latest posts</h2>
        <a href="/blog" class="shrink-0 text-[14px] font-medium text-muted transition-colors hover:text-ink">
          View all posts →
        </a>
      </div>

      <div class="mt-7 flex flex-col gap-4">
        {latest.map((post) => <PostCard post={post} />)}
      </div>
    </section>
  </main>
</Layout>
