---
import Layout from '../components/Layout.astro';

const projects = [
  {
    name: 'ivanwrites.dev',
    description: 'This blog — a minimal, fast personal site built with Astro and Tailwind.',
    href: '#',
    stack: ['Astro', 'Tailwind', 'AWS'],
  },
  {
    name: 'Trailpace',
    description: 'A tiny running log that tracks consistency instead of pace.',
    href: '#',
    stack: ['TypeScript', 'SQLite'],
  },
  {
    name: 'Deletebox',
    description: 'Experiments in writing small, disposable modules you can remove without fear.',
    href: '#',
    stack: ['Node', 'Vitest'],
  },
];
---

<Layout title="Projects" description="Things Ivan has built.">
  <main class="mx-auto w-full max-w-3xl flex-1 px-5 py-12 sm:px-6 sm:py-16">
    <h1 class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">Projects</h1>
    <p class="mt-3 text-[16px] leading-relaxed text-muted">A few things I've built and tinkered with.</p>

    <div class="mt-10 flex flex-col gap-4">
      {
        projects.map(({ name, description, href, stack }) => (
          <a href={href} class="rounded-2xl border border-border bg-page p-5 transition-colors hover:border-faint/60">
            <div class="flex items-center justify-between gap-4">
              <h2 class="text-base font-bold tracking-tight text-ink">{name}</h2>
              <span class="text-faint" aria-hidden="true">→</span>
            </div>
            <p class="mt-1.5 text-sm leading-relaxed text-muted">{description}</p>
            <div class="mt-3 flex flex-wrap gap-1.5">
              {stack.map((tech) => (
                <span class="rounded-md bg-tag-soft px-2 py-0.5 text-[12px] font-medium text-tag">{tech}</span>
              ))}
            </div>
          </a>
        ))
      }
    </div>
  </main>
</Layout>
