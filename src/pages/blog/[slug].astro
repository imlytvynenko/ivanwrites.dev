---
import { getCollection, render } from 'astro:content';
import Layout from '../../components/Layout.astro';
import CategoryBadge from '../../components/CategoryBadge.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { title, description, category, date, tags, image, imageAlt, readTime } = post.data;

const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2);

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<Layout title={title} description={description}>
  <main class="flex-1">
    <article class="mx-auto max-w-5xl px-5 py-10 sm:px-6 sm:py-12">
      <a href="/blog" class="inline-flex items-center gap-2 text-[14px] text-muted transition-colors hover:text-ink">
        <span aria-hidden="true">←</span>
        Back to all posts
      </a>

      <header class="mt-8 max-w-3xl">
        <CategoryBadge category={category} />
        <h1 class="mt-3 text-3xl font-bold leading-tight tracking-tight text-ink sm:text-4xl">
          {title}
        </h1>
        <p class="mt-4 text-[16px] leading-relaxed text-muted sm:text-base">{description}</p>

        <div class="mt-6 flex flex-wrap items-center gap-2.5 text-sm text-muted">
          <span class="flex h-8 w-8 items-center justify-center overflow-hidden rounded-full border border-border bg-white">
            <img src="/icons/lion-icon.png" alt="" class="h-6 w-6 object-contain" width="24" height="24" />
          </span>
          <span class="font-medium text-ink">Ivan</span>
          <span class="text-faint" aria-hidden="true">·</span>
          <span>{formattedDate}</span>
          <span class="text-faint" aria-hidden="true">·</span>
          <span>{readTime}</span>
        </div>
      </header>

      {
        image && (
          <img
            src={image}
            alt={imageAlt || title}
            class="mt-8 aspect-[16/9] w-full rounded-2xl border border-border object-cover"
            width="1400"
            height="788"
            fetchpriority="high"
          />
        )
      }

      <div class="mt-10 grid gap-12 lg:grid-cols-[minmax(0,1fr)_200px]">
        <div class="prose max-w-2xl">
          <Content />

          {
            tags.length > 0 && (
              <div class="mt-10 flex flex-wrap gap-1.5">
                {tags.map((tag) => (
                  <span class="rounded-md bg-tag-soft px-2 py-0.5 text-[12px] font-medium text-tag">{tag}</span>
                ))}
              </div>
            )
          }
        </div>

        {
          toc.length > 0 && (
            <aside class="hidden lg:block">
              <div class="sticky top-28 rounded-xl border border-border bg-subtle p-5">
                <p class="text-[12px] font-semibold uppercase tracking-wide text-faint">On this page</p>
                <nav class="mt-4">
                  <ul class="space-y-2.5 border-l border-border">
                    {toc.map((h) => (
                      <li>
                        <a
                          href={`#${h.slug}`}
                          class="-ml-px block border-l-2 border-transparent pl-3 text-[14px] text-muted transition-colors hover:border-ink hover:text-ink"
                        >
                          {h.text}
                        </a>
                      </li>
                    ))}
                  </ul>
                </nav>
              </div>
            </aside>
          )
        }
      </div>
    </article>
  </main>
</Layout>
