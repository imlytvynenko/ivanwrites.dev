---
import { getCollection } from 'astro:content';
import Layout from '../../components/Layout.astro';
import PostCard from '../../components/PostCard.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<Layout title="Blog" description="All posts from Ivan Writes.">
  <main class="mx-auto w-full max-w-5xl flex-1 px-5 py-12 sm:px-6 sm:py-16">
    <header class="max-w-2xl">
      <h1 class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">Blog</h1>
      <p class="mt-3 text-[16px] leading-relaxed text-muted">
        Writing on software, lifestyle, running, travel, and the lessons in between.
      </p>
    </header>

    <div class="mt-10 flex flex-col gap-4">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </main>
</Layout>
