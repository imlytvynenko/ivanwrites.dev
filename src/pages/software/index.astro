---
import { getCollection } from 'astro:content';
import Layout from '../../components/Layout.astro';
import PostCard from '../../components/PostCard.astro';

const posts = (await getCollection('blog'))
  .filter((post) => post.data.category === 'Software Development')
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Layout title="Software Development" description="Posts on software development and building things.">
  <main class="mx-auto w-full max-w-5xl flex-1 px-5 py-12 sm:px-6 sm:py-16">
    <header class="max-w-2xl">
      <p class="text-[12px] font-semibold uppercase tracking-wide text-blue">Category</p>
      <h1 class="mt-2 text-3xl font-bold tracking-tight text-ink sm:text-4xl">Software Development</h1>
      <p class="mt-3 text-[16px] leading-relaxed text-muted">
        Notes on building software, tooling, and shipping projects without the overhead.
      </p>
    </header>

    <div class="mt-10 flex flex-col gap-4">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </main>
</Layout>
