---
import Layout from '../components/Layout.astro';

const groups = [
  {
    title: 'Editor & Dev',
    items: [
      ['Editor', 'VS Code'],
      ['Terminal', 'Ghostty + zsh'],
      ['Framework', 'Astro'],
      ['Styling', 'Tailwind CSS'],
    ],
  },
  {
    title: 'Hardware',
    items: [
      ['Laptop', 'MacBook Air'],
      ['Keyboard', 'A quiet mechanical board'],
      ['Headphones', 'Noise-cancelling, always'],
    ],
  },
  {
    title: 'Everyday',
    items: [
      ['Notes', 'Plain Markdown files'],
      ['Tasks', 'A single text file'],
      ['Running', 'A basic GPS watch'],
    ],
  },
];
---

<Layout title="Uses" description="The tools and gear Ivan uses.">
  <main class="mx-auto w-full max-w-3xl flex-1 px-5 py-12 sm:px-6 sm:py-16">
    <h1 class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">Uses</h1>
    <p class="mt-3 text-[16px] leading-relaxed text-muted">
      The hardware, software, and tools I rely on day to day.
    </p>

    <div class="mt-10 flex flex-col gap-10">
      {
        groups.map(({ title, items }) => (
          <section>
            <h2 class="text-base font-bold tracking-tight text-ink">{title}</h2>
            <dl class="mt-3 divide-y divide-border border-y border-border">
              {items.map(([label, value]) => (
                <div class="flex items-center justify-between gap-4 py-3">
                  <dt class="text-sm text-muted">{label}</dt>
                  <dd class="text-sm font-medium text-ink">{value}</dd>
                </div>
              ))}
            </dl>
          </section>
        ))
      }
    </div>
  </main>
</Layout>
